# API Configuration
API_KEY=your_secure_api_key_here
API_TITLE=Borges Knowledge Graph API
API_VERSION=1.0.0
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/borges_kg

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=borges-knowledge-graph
S3_PRESIGNED_URL_EXPIRY=3600

# LLM API Keys (for pipeline execution)
OPENAI_API_KEY=your_openai_api_key
BACKUP_OPENAI_API_KEY=your_backup_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# Qdrant Configuration
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_URL=your_qdrant_url

# LangChain Configuration
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Borges Knowledge Graph

# Pipeline Configuration (Fixed defaults)
DEFAULT_EXTRACTION_MODEL=gpt-4.1
DEFAULT_MERGING_MODEL=gpt-4.1-mini
USE_ITERATIVE_DEDUP=true
ITERATIVE_DEDUP_MAX_ROUNDS=10
ENABLE_COST_TRACKING=true
CHUNK_SIZE=8000
CHUNK_OVERLAP=300
BATCH_SIZE=50

# File Upload Limits
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_REQUEST=20
TEMP_UPLOAD_DIR=temp_uploads
